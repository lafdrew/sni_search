# ============================================
# 个人配置 - .env 文件
# ============================================

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sni_domain_mapping

# LLM Provider Configuration (必填)
# 可选值: claude, openai
LLM_PROVIDER=openai

# Claude API Configuration (当 LLM_PROVIDER=claude 时必填)
ANTHROPIC_API_KEY=sk-db7FkOTFrmARWju5R4CRigdc4YLl23V2Ek1fCuqE0VfWCgmE
ANTHROPIC_BASE_URL=https://api.lingyaai.cn

# Model Configuration (必填)
CLAUDE_MODEL=claude-sonnet-4-5-20250929-thinking
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# OpenAI API Configuration (当 LLM_PROVIDER=openai 时必填)
OPENAI_API_KEY=sk-HgPu0PS2SSeR7Q0Aqy74EJSJPx5DnkC9tQ1XnPO4R8pKLGAE
OPENAI_MODEL=gpt-5.1-chat-latest
OPENAI_BASE_URL=https://api.lingyaai.cn/v1

# API Configuration
API_HOST=0.0.0.0
API_PORT=9000

# LangSmith (可选)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=sni-recognition
# LANGCHAIN_API_KEY=your-langsmith-api-key

# Data paths
DATA_DIR=./results

# Web Search Configuration
# SEARCH_API=searchapi
SEARCH_API=tavily
MAX_SEARCH_RESULTS=5

# Optional: SearchApi (SearchApi.io 服务，需要 API key)
SEARCHAPI_API_KEY=q62m4GQDNQbzkxk8hq5DVKJ6

# Optional: Tavily Search (高质量结果，需要 API key)
TAVILY_API_KEY=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

# Optional: InfoQuest Search (BytePlus 服务，需要 API key)
INFOQUEST_API_KEY=MzAwMTAwNjkyNA==BNWIrTJs2ahGeTwBjwlJPRDSPzUcIR3L

# Optional: Other search engines
# BRAVE_SEARCH_API_KEY=your-brave-api-key
# SERPER_API_KEY=your-serper-api-key

# Crawler Configuration
CRAWLER_ENGINE=jina
CRAWLER_TIMEOUT=30

# TGT Standard Library Configuration
TGT_VECTOR_THRESHOLD=0.65
TGT_LLM_CONFIDENCE_THRESHOLD=0.8

# Optional: Jina Reader API Key (更高速率限制)
# JINA_API_KEY=your-jina-api-key
