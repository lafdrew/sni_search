# ============================================
# 个人配置模板 - .env.example
# 复制此文件为 .env 并填入你的实际配置
# ============================================

# Qdrant Configuration (必填)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sni_domain_mapping

# TGT Standard Library Configuration (可选)
QDRANT_TGT_COLLECTION=tgt_standard_library
TGT_LIBRARY_ENABLED=true
TGT_VECTOR_THRESHOLD=0.75
TGT_LLM_CONFIDENCE_THRESHOLD=0.8

# LLM Provider Configuration (必填)
# 可选值: claude, openai
LLM_PROVIDER=claude

# Claude API Configuration (当 LLM_PROVIDER=claude 时必填)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model Configuration (当使用 Claude 时必填)
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Embedding Model Configuration
# Options:
#   1. Online model (HuggingFace): sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#   2. Local model (offline): E:\sni_search\models\embeddings (run: uv run python scripts/download_embedding_model.py)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# OpenAI API Configuration (当 LLM_PROVIDER=openai 时必填)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4-turbo-preview
# OPENAI_BASE_URL=https://api.openai.com/v1

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# LangSmith (可选)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=sni-recognition
# LANGCHAIN_API_KEY=your-langsmith-api-key

# Data paths (必填)
DATA_DIR=./results

# Web Search Configuration (必填)
# SEARCH_API options: tavily, infoquest, searchapi, duckduckgo, brave, serper, arxiv, searx, wikipedia
SEARCH_API=duckduckgo
MAX_SEARCH_RESULTS=5

# Optional: SearchApi (SearchApi.io 服务，需要 API key)
# SEARCHAPI_API_KEY=your-searchapi-api-key

# Optional: Tavily Search (高质量结果，需要 API key)
# TAVILY_API_KEY=your-tavily-api-key

# Optional: InfoQuest Search (BytePlus 服务，需要 API key)
# INFOQUEST_API_KEY=your-infoquest-api-key

# Optional: Other search engines
# BRAVE_SEARCH_API_KEY=your-brave-api-key
# SERPER_API_KEY=your-serper-api-key

# Crawler Configuration (必填)
CRAWLER_ENGINE=jina
CRAWLER_TIMEOUT=30

# Optional: Jina Reader API Key (更高速率限制)
# JINA_API_KEY=your-jina-api-key
